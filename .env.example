# === REQUIRED ===
# Discord webhook URL for booking notifications
DISCORD_WEBHOOK_URL=

# Cloudflare Turnstile (invisible CAPTCHA)
# Get keys at: https://dash.cloudflare.com → Turnstile → Add site
# Widget mode: Managed | Domain: your-domain.vercel.app
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAD4ff2YF5jQcXzOy
TURNSTILE_SECRET_KEY=0x4AAAAAAD4ff6NC4lZMUIlF33-RzU_YhFA

# HMAC-SHA256 secret for request signing (same value for both)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUBMISSION_HMAC_SECRET=
NEXT_PUBLIC_HMAC_SECRET=

# === OPTIONAL ===
# Resend API key for booking confirmation emails
# Get key at: https://resend.com → API Keys → Create
RESEND_API_KEY=

# Email addresses for confirmation emails
FROM_EMAIL=noreply@yourdomain.com
TO_EMAIL=your-email@gmail.com

# Sentry DSN for error tracking
# Get DSN at: https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
